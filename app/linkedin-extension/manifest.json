{
    "manifest_version": 3,
    "name": "LinkedIn to BUK Bridge",
    "version": "1.0",
    "description": "Extrae datos reales de candidaturas de LinkedIn y los envía al Middleware BUK de Ceiba.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:3000/*",
        "https://*.linkedin.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Enviar a BUK"
    }
}